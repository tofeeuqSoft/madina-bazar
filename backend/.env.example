PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb://127.0.0.1:27017/madina-bazar

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

CLIENT_URL=https://www.madinabazar.com
API_URL=https://www.madinabazar.com

# Social login — Google (console.cloud.google.com → OAuth Client ID, Web)
GOOGLE_CLIENT_ID=

# Social login — Facebook (developers.facebook.com → App ID + Secret)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# bKash
BKASH_SANDBOX=false
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Nagad
NAGAD_SANDBOX=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=

# SSLCommerz
SSLCOMMERZ_LIVE=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Barikoi
BARIKOI_API_KEY=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=madina-bazar

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS — MimSMS (Bangladesh, recommended for OTP)
MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=MadinaBazar
MIMSMS_API_URL=https://api.mimsms.com/api/SmsSending/SMS

# SMS — Twilio / generic provider (fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MadinaBazar

# Rate Limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAYMENT_WINDOW_MS=3600000
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=60

# Courier credential encryption (generate random hex, keep secret)
CREDENTIAL_SECRET=

# Background worker + scheduler
WORKER_INTERVAL_MS=15000
ENABLE_CRON=true

# Search rate limit (location autocomplete, tracking)
RATE_LIMIT_SEARCH_WINDOW_MS=900000
RATE_LIMIT_SEARCH_MAX=60
