{
  "name": "madina-bazar-backend",
  "version": "1.0.0",
  "description": "Madina Bazar E-Commerce Backend - MERN Stack",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seed.js",
    "seed:categories": "node utils/seedCategories.js",
    "seed:products": "node utils/seedProducts.js",
    "seed:all": "node utils/seed.js && node utils/seedCategories.js && node utils/seedDeliveryAreas.js",
    "seed:delivery": "node utils/seedDeliveryAreas.js",
    "seed:zones": "node utils/seedGroceryZones.js",
    "seed:delivery-mgmt": "node utils/seedDelivery.js",
    "seed:dummy": "node utils/seedDummy.js",
    "seed:support": "node utils/seedSupport.js",
    "seed:inventory": "node utils/seedInventory.js",
    "seed:delivery-network": "node utils/seedDeliveryNetwork.js",
    "test:delivery": "node --test tests/delivery.test.js",
    "test": "node --test \"tests/*.test.js\"",
    "backup": "node utils/backup.js"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "madina-bazar"
  ],
  "author": "Madina Bazar Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
