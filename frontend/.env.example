# Copy to .env and fill values
# API base (dev-e vite proxy use hoy, production-e domain)
VITE_API_URL=http://localhost:5000/api

# Social login — Google (console.cloud.google.com → APIs & Services → Credentials → OAuth Client ID, Web application)
# Authorized JavaScript origins-e jog korun:
#   http://localhost:5173
#   https://www.madinabazar.com
VITE_GOOGLE_CLIENT_ID=

# Social login — Facebook (developers.facebook.com → Create App → Facebook Login → Web)
# Valid OAuth Redirect URIs / Domains-e domain bosan
# (Same App ID product-share Messenger chat-redirect-eo use hoy)
VITE_FACEBOOK_APP_ID=

# Product share → X chat (DM): brand X account-এর numeric user ID
# (na thakle X button post-intent khulbe). ID paben: x.com → brand profile → page source-e "user_id"
VITE_X_RECIPIENT_ID=
